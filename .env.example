# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Settings → API → service_role secret. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# OpenAI — used for chat completions, embeddings, and Whisper STT (server-only)
OPENAI_API_KEY=sk-your-openai-key

# Content Studio GitHub publishing — OPTIONAL. Use a fine-grained token scoped
# to this repository with Contents + Pull requests write permissions. The
# portal creates draft PRs only; it never writes main or enables auto-merge.
GITHUB_CONTENT_TOKEN=
GITHUB_CONTENT_REPOSITORY=eimis1990/chatzone
GITHUB_CONTENT_BASE_BRANCH=main

# ElevenLabs — OPTIONAL, enables text-to-speech voice replies (server-only).
# Voice features return 503 and stay hidden until this is set.
ELEVENLABS_API_KEY=

# Gemini API — enables room visualization (server-only).
GEMINI_API_KEY=

# Public base URL of this app (used by the embeddable widget)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Billing (server-only). Hosted Checkout does not need a publishable key
# in the browser. Price ids are account-specific.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTH=
STRIPE_PRICE_STARTER_YEAR=
STRIPE_PRICE_GROWTH_MONTH=
STRIPE_PRICE_GROWTH_YEAR=
STRIPE_PRICE_SCALE_MONTH=
STRIPE_PRICE_SCALE_YEAR=
STRIPE_PRICE_VOICE_MONTH=
STRIPE_PRICE_VOICE_OVERAGE=
STRIPE_PRICE_VISUALIZER_MONTH=
STRIPE_PRICE_SETUP_ESSENTIAL=
STRIPE_PRICE_SETUP_ECOMMERCE=

# Transactional email (lead + handoff notifications). Optional — skipped when unset.
RESEND_API_KEY=
# Verified sender, e.g. "Loqara <notifications@loqara.com>". Falls back to Resend's sandbox sender.
EMAIL_FROM=
HOSTINGER_EMAIL_PASSWORD=
